{
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=fdms_gateway;User=root;Password=;"
  },
  "Fdms": {
    "TestBaseUrl": "https://fdmsapitest.zimra.co.zw",
    "ProductionBaseUrl": "https://fdmsapi.zimra.co.zw",
    "TimeoutSeconds": 30,
    "MaxTransientRetries": 2,
    "AcceptAnyServerCertificate": true
  },
  "Jwt": {
    "Key": "",
    "Issuer": "fdms-gateway",
    "Audience": "fdms-gateway-users",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Backup": {
    "Enabled": true,
    "IntervalHours": 24,
    "KeepLast": 14,
    "Path": "backups"
  },
  "SmtpClientSetting": {
    "Enabled": true,
    "Host": "mail.daraerp.co.zw",
    "Port": 465,
    "EnableSsl": true,
    "fromUsername": "support@daraerp.co.zw",
    "fromPassword": "",
    "FromAddress": "support@daraerp.co.zw",
    "FromName": "FDMS Gateway"
  },
  "FiscalDay": {
    "AutoCloseTime": "23:59"
  },
  "Logs": {
    "ErrorRetentionDays": 90
  },
  "Hosting": {
    "BehindProxy": false,
    "PublicUrl": ""
  },
  "Seed": {
    "Enabled": true,
    "AdminEmail": "support@daraerp.co.zw",
    "AdminPassword": "",
    "AdminName": "Platform",
    "ForcePasswordChange": true
  },
  "Identity": {
    "MinPasswordLength": 10
  },
  "DataProtection": {
    "KeysPath": "",
    "UseDpapi": false
  },
  "Database": {
    "AutoMigrate": false
  },
  "RateLimit": {
    "PerMinute": 120,
    "LoginPerMinute": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/fdms-.log", "rollingInterval": "Day", "retainedFileCountLimit": 60 } }
    ]
  },
  "AllowedHosts": "*"
}
